---
import Base from "../layouts/Base.astro";
import "../styles/global.css";

const files = import.meta.glob("../../data/*/*.json", { eager: true });
const KANDA_NAMES = { achar: "Achar Kanda", preta: "Preta Kanda", brahma: "Brahma Kanda" };
const ORDER = ["achar", "preta", "brahma"];

const chapters = Object.values(files).sort(
  (a, b) => ORDER.indexOf(a.kanda) - ORDER.indexOf(b.kanda) || a.chapter - b.chapter,
);

const allVerses = chapters.flatMap((c) => c.verses);
const written = allVerses.filter((v) => (v.hinglish || "").trim()).length;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="Garuda Purana — an open corpus with a Hinglish retelling"
  description="The Garuda Purana, openly published, with a plain-language Hinglish retelling. No, it is not only read after a death."
>
  <div class="wrap">
    <header class="masthead">
      <h1>गरुड़ पुराण</h1>
      <p class="sub">Garuda Purana — read, retold, and published as it goes</p>
    </header>

    <section class="myth">
      <p class="claim">
        Around <em>90%</em> of the Garuda Purana has nothing to do with death.
      </p>
      <p>
        There is a widespread belief that this text is only read after a bereavement, or
        that reading it invites misfortune. It is not true, and it has kept people away
        from a book they are perfectly entitled to read.
      </p>
      <p>
        The bulk of it is the Achar Kanda — cosmology, ethics, ayurveda, and a long
        section on gemstones. The material about death and the afterlife sits in the
        Preta Kanda, near the end. Most people have only ever met that portion, usually
        through the <em>Saroddhara</em>, a sixteen-chapter digest that gets sold as though
        it were the whole Purana. That confusion is where the myth comes from.
      </p>
    </section>

    <section class="section">
      <h2>Four layers, every verse</h2>
      <ul class="layers">
        <li><span class="name">Sanskrit</span><span class="what">The verse in Devanagari, from the Venkatesvara recension via GRETIL.</span></li>
        <li><span class="name">IAST</span><span class="what">Roman transliteration, for anyone who does not read Devanagari.</span></li>
        <li><span class="name">Hindi</span><span class="what">The Gita Press translation, used with their permission.</span></li>
        <li><span class="name">Hinglish</span><span class="what">A plain-language retelling. Not a translation, and never shown instead of the Hindi — only beside it.</span></li>
      </ul>
    </section>

    <section class="section">
      <h2>Chapters</h2>
      {chapters.length === 0 ? (
        <p class="empty">Nothing published yet.</p>
      ) : (
        <ul class="chapters">
          {chapters.map((c) => (
            <li>
              <a href={`${base}/read/${c.kanda}/${c.chapter}/`}>
                <span class="ch-title">
                  {KANDA_NAMES[c.kanda]} &middot; {c.chapter}
                  {c.title?.en && ` — ${c.title.en}`}
                </span>
                <span class="ch-count">
                  {c.verses.filter((v) => (v.hinglish || "").trim()).length}/{c.verses.length} retold
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="tally">
        <strong>{written}</strong> of {allVerses.length} published verses retold so far. The corpus
        grows as the text gets read, one sitting at a time.
      </p>
    </section>

    <footer class="sources">
      Sanskrit from <a href="https://gretil.sub.uni-goettingen.de/">GRETIL</a>. Hindi from the
      Gita Press <em>Sankshipt Garud Puran</em>, used with permission. English reference from
      Manmatha Nath Dutt (c. 1908, public domain). Code MIT, original writing CC BY-SA 4.0 —
      see <a href="https://github.com/justadityaraj/garuda-purana/blob/main/NOTICE.md">NOTICE.md</a>.
      &nbsp;·&nbsp; <a href="https://github.com/justadityaraj/garuda-purana">Source on GitHub</a>
    </footer>
  </div>
</Base>
