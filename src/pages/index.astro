---
import Base from "../layouts/Base.astro";
import hi from "../i18n/hi.json";
import "../styles/home.css";

const files = import.meta.glob("../../data/*/*.json", { eager: true });
const KANDA_EN = { achar: "Achar Kanda", preta: "Preta Kanda", brahma: "Brahma Kanda" };
const ORDER = ["achar", "preta", "brahma"];

// Hindi is optional everywhere. A blank string means "not written yet" and the
// line is skipped — never rendered empty, never faked.
const t = (key) => (hi[key] || "").trim();

const chapters = Object.values(files).sort(
  (a, b) => ORDER.indexOf(a.kanda) - ORDER.indexOf(b.kanda) || a.chapter - b.chapter,
);
const allVerses = chapters.flatMap((c) => c.verses);
const written = allVerses.filter((v) => (v.hinglish || "").trim()).length;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="गरुड़ पुराण — Garuda Purana, openly published with a Hinglish retelling"
  description="The Garuda Purana, openly published, with a plain-language Hinglish retelling. No, it is not only read after a death."
>
  <div class="home">
    <section class="hero">
      <div class="hero-art" data-parallax></div>
      <div class="shell hero-copy">
        <p class="roman" data-rise>Garuda Purana</p>
        <h1 data-rise>{t("title")}</h1>
        <p class="lede" data-rise>
          {t("hero_lede") || "Being read, and retold in plain language — one verse at a time."}
        </p>
      </div>
      <div class="scroll-cue">scroll</div>
    </section>

    <div class="shell">
      <section class="band" id="chapters">
        <header class="band-head reveal">
          {t("chapters_heading") && <h2 class="hi">{t("chapters_heading")}</h2>}
          <p class:list={["en", { lead: !t("chapters_heading") }]}>Chapters</p>
        </header>

        <ul class="ch-list">
          {chapters.map((c) => (
            <li class="reveal">
              <a href={`${base}/read/${c.kanda}/${c.chapter}/`}>
                <span class="n">{c.chapter}</span>
                <span class="name">
                  {t(`kanda_${c.kanda}`) || KANDA_EN[c.kanda]}
                  <small>{KANDA_EN[c.kanda]}{c.title?.en ? ` — ${c.title.en}` : ""}</small>
                </span>
                <span class="tally">
                  {c.verses.filter((v) => (v.hinglish || "").trim()).length}/{c.verses.length}
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="running reveal">
          <b>{written}</b> of {allVerses.length} verses retold so far.
        </p>
      </section>

      <section class="band" id="layers">
        <header class="band-head reveal">
          {t("layers_heading") && <h2 class="hi">{t("layers_heading")}</h2>}
          <p class:list={["en", { lead: !t("layers_heading") }]}>Every verse, three ways</p>
        </header>

        <div class="layer-grid">
          <div class="layer reveal">
            <div class="tag">{t("layer_sanskrit_label")}</div>
            <div class="body">
              {t("layer_sanskrit_body") && <span class="hi">{t("layer_sanskrit_body")}</span>}
              <span class="en">The original verse in Devanagari.</span>
            </div>
          </div>
          <div class="layer reveal">
            <div class="tag">{t("layer_hindi_label")}</div>
            <div class="body">
              {t("layer_hindi_body") && <span class="hi">{t("layer_hindi_body")}</span>}
              <span class="en">The Gita Press translation, used with their permission.</span>
            </div>
          </div>
          <div class="layer reveal">
            <div class="tag">{t("layer_hinglish_label")}</div>
            <div class="body">
              {t("layer_hinglish_body") && <span class="hi">{t("layer_hinglish_body")}</span>}
              <span class="en">
                Plain language, the way a friend would explain it. A retelling, not a translation —
                always shown beside the Hindi, never instead of it.
              </span>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="myth-band">
      <div class="myth-plate" data-parallax-slow>
        <img src={`${base}/img/garuda-ravivarma-1910.jpg`} alt="Vishnu riding Garuda, Ravi Varma studio lithograph, c. 1910" />
      </div>
      <div class="shell">
        <div class="myth-inner">
          {t("myth_claim") && <p class="myth-claim reveal">{t("myth_claim")}</p>}
          <p class:list={["myth-claim-en reveal", { lead: !t("myth_claim") }]}>
            Around <b>90%</b> of the Garuda Purana has nothing to do with death.
          </p>

          <div class="myth-body">
            {t("myth_para_1") && <p class="hi reveal">{t("myth_para_1")}</p>}
            <p class="en reveal">
              Many people believe this text is only read after a death, or that reading it invites
              misfortune. It is not true, and that fear has kept people away from a book anyone is
              free to read.
            </p>
            {t("myth_para_2") && <p class="hi reveal">{t("myth_para_2")}</p>}
            <p class="en reveal">
              The bulk of it is the Achar Kanda — cosmology, ethics, ayurveda, and a long section on
              gemstones. The death material sits in the Preta Kanda, near the end. Most people have
              only met that portion, usually through the <em>Saroddhara</em>, a sixteen-chapter digest
              mistaken for the whole Purana. That is where the myth begins.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="shell">
      <footer class="foot">
        Sanskrit from <a href="https://gretil.sub.uni-goettingen.de/">GRETIL</a> (Venkatesvara
        recension). Hindi from the Gita Press <em>Sankshipt Garud Puran</em>, used with permission.
        <br />
        Artwork: <em>Vishnu Carried by Garuda Through a Stormy Sky</em>, Kotah, 1775 — and a Ravi
        Varma studio lithograph, c. 1910. Both public domain via Wikimedia Commons.
        <br />
        Code MIT, original writing CC BY-SA 4.0 —
        <a href="https://github.com/justadityaraj/garuda-purana/blob/main/NOTICE.md">NOTICE.md</a>
        &nbsp;·&nbsp;
        <a href="https://github.com/justadityaraj/garuda-purana">Source on GitHub</a>
      </footer>
    </div>
  </div>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Content is visible by default in CSS. Only once GSAP has actually loaded
    // do we mark the document and hide things to animate them in — so a JS
    // failure, a blocked bundle, or reduced-motion leaves a readable page.
    if (!still) {
      document.documentElement.classList.add("js-anim");

      gsap.to("[data-rise]", {
        y: 0, opacity: 1, duration: 1.15, ease: "power3.out", stagger: 0.13, delay: 0.15,
      });

      gsap.to("[data-parallax]", {
        yPercent: 17, ease: "none",
        scrollTrigger: { trigger: ".hero", start: "top top", end: "bottom top", scrub: true },
      });

      gsap.to("[data-parallax-slow]", {
        yPercent: -13, ease: "none",
        scrollTrigger: { trigger: ".myth-band", start: "top bottom", end: "bottom top", scrub: true },
      });

      gsap.utils.toArray(".reveal").forEach((el) => {
        gsap.to(el, {
          y: 0, opacity: 1, duration: 0.85, ease: "power2.out",
          scrollTrigger: { trigger: el, start: "top 92%", once: true },
        });
      });

      gsap.to(".scroll-cue", {
        opacity: 0, duration: 0.4,
        scrollTrigger: { trigger: ".hero", start: "top -60", toggleActions: "play none none reverse" },
      });

      // Anything still hidden after load gets shown rather than left blank.
      window.addEventListener("load", () => {
        ScrollTrigger.refresh();
        setTimeout(() => {
          document.querySelectorAll(".reveal, [data-rise]").forEach((el) => {
            if (getComputedStyle(el).opacity === "0") gsap.set(el, { opacity: 1, y: 0 });
          });
        }, 1200);
      });
    }
  </script>
</Base>
